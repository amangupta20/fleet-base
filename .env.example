# Fleet base — local-only env example.
# celld dev reads `.dev.vars` beside the Wrangler config, else `.env` then
# `.env.local` (which overrides `.env`). Copy this file to `.dev.vars` for
# local runs. `celld deploy` does NOT read these files.
#
# With every provider blank, `celld dev` still starts and `GET /health`
# returns ok. Prompts return 500 until one provider path is set below.

# S3-compatible fleet bucket, e.g. s3://my-fleet. NOT needed for local `celld dev`
# (dev uses a local object store). Needed for bucket deploys / fleet nodes.
CELLD_BUCKET=

# S3 access key for the fleet bucket. NOT needed for local `celld dev`.
AWS_ACCESS_KEY_ID=

# S3 secret key for the fleet bucket. NOT needed for local `celld dev`.
AWS_SECRET_ACCESS_KEY=

# Storage region, e.g. `auto` for R2. NOT needed for local `celld dev`.
AWS_REGION=

# S3-compatible endpoint, e.g. https://ACCOUNT_ID.r2.cloudflarestorage.com.
# NOT needed for local `celld dev`.
S3_ENDPOINT=

# Your own OpenAI-compatible router (LiteLLM, Ollama, vLLM, LM Studio, own
# gateway...). No OpenAI/Gemini key needed when this is set.
# Base URL of the router's OpenAI-compatible API. Defaults to Ollama's
# http://localhost:11434/v1 when ROUTER_MODEL is set without it.
ROUTER_BASE_URL=

# API key for the router. Leave empty for keyless local servers (Ollama).
ROUTER_API_KEY=

# Default model id on the router, e.g. llama-3.1-8b. Wins as the default
# model when set. GET /models shows live ids from your router.
ROUTER_MODEL=

# Extra router model ids to pre-register (comma-separated), usable via the
# per-request `model` override without a restart.
ROUTER_EXTRA_MODELS=

# OpenCode Go hosted inference (https://opencode.ai). Needs a key.
# OPENCODE_MODEL pins the default (GET /models shows the catalog).
OPENCODE_API_KEY=
OPENCODE_MODEL=

# OpenAI key for the Pi model provider. Needed for local `celld dev` UNLESS
# one of ROUTER_MODEL/ROUTER_BASE_URL, OPENCODE_API_KEY, GEMINI_API_KEY is set.
OPENAI_API_KEY=

# Gemini key for the Pi model provider. Needed for local `celld dev` UNLESS
# one of ROUTER_MODEL/ROUTER_BASE_URL, OPENCODE_API_KEY, OPENAI_API_KEY is set.
# GEMINI_API_KEY=
