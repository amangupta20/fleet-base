[Unit]
Description=fleet celld node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Placeholders: replace with the real deploy user and checkout path.
User=fleet
WorkingDirectory=/opt/fleet/fleet-base
EnvironmentFile=/etc/fleet/celld.env
ExecStart=/usr/local/bin/celld --bucket ${CELLD_BUCKET} --endpoint ${S3_ENDPOINT} --region ${AWS_REGION} --listen 0.0.0.0:8080 --internal-listen 127.0.0.1:8081 --advertise 127.0.0.1:8081
Restart=always
# A fenced node waits out one lease lifetime (CELLD_TTL_MS=360000 => 360 s)
# before restarting, so its old lease expires and a peer can take over cleanly.
RestartSec=70
# Grace must exceed CELLD_SHUTDOWN_TOTAL_MS (default 40000) or SIGKILL can cut the handoff.
TimeoutStopSec=90

# Multi-node example (Tailscale overlay). Peer traffic has NO TLS: the
# /peer/tunnel establishment carries the fleet HMAC with clock/replay
# protection, but calls inside the tunnel are plain unsigned HTTP, and most
# operator routes have no request auth at all (see docs/security.md). Never
# expose the internal listener to the public internet — keep it on a trusted
# private network / encrypted overlay.
# ExecStart=/usr/local/bin/celld --bucket ${CELLD_BUCKET} --endpoint ${S3_ENDPOINT} --region ${AWS_REGION} --listen 0.0.0.0:8080 --internal-listen 100.64.0.12:8081 --advertise 100.64.0.12:8081

[Install]
WantedBy=multi-user.target
